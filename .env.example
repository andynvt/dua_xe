# Copy thành .env rồi điền. .env không bị commit.
# Key OpenAI cho bình luận viên AI; bỏ trống thì dùng câu mẫu
OPENAI_API_KEY=
# Model, mặc định gpt-5-mini
OPENAI_MODEL=gpt-5-mini
# Ngôn ngữ bình luận: en (mặc định) hoặc vi
COMMENT_LANG=en
# Mã để màn hình host bấm bắt đầu; bỏ trống thì mỗi lần chạy tạo mã ngẫu nhiên
HOST_KEY=f1b4b2
# Link cố định cho QR (nếu có domain riêng); bỏ trống thì tự lấy link cloudflared
PUBLIC_URL=
